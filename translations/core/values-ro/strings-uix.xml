  <string name="payment_screen_need_help_subtitle">Aveți nevoie de ajutor? Vizitați site-ul nostru web</string>
  <string name="payment_screen_pay_via_google"><![CDATA[<string name=\\\"payment_screen_pay_via_google\\\">Plătiți prin Google Play (<xliff:g name=\\\"price\\\" example=\\\"~$2.99\\\">%s</xliff:g> + taxe)</string>]]></string>
  <string name="payment_screen_pay_via_futopay"><![CDATA[<string name=\\\"payment_screen_pay_via_futopay\\\">Plătește (<xliff:g name=\\\"price\\\" example=\\\"~$2.99\\\">%s</xliff:g> + taxe)</string>]]></string>
  <string name="payment_screen_more_options">Alte opțiuni</string>
  <string name="payment_screen_payment_complete_title">Plată finalizată</string>
  <string name="payment_screen_aftersales_title">Vă mulțumim</string>
  <string name="payment_screen_aftersales_title_pending">Plată în așteptare</string>
  <string name="payment_screen_aftersales_paragraph_1">Vă mulțumim că ați achiziționat tastatura FUTO!</string>
  <string name="payment_screen_aftersales_paragraph_2">Achiziția ta va susține dezvoltarea continuă a tastaturii FUTO și a altor proiecte FUTO.</string>
  <string name="payment_screen_aftersales_paragraph_2_pending">Plata este încă în așteptare, dar ar trebui să fie procesată în curând.</string>
  <string name="payment_screen_aftersales_paragraph_3">Dacă tocmai ați efectuat plata, este posibil ca aceasta să fie încă în curs de procesare, veți primi un e-mail cu mai multe informații.</string>
  <string name="payment_screen_payment_failed_title">Eroare de plată</string>
  <string name="payment_screen_payment_failed_body">Din păcate, plata a eșuat din diverse motive. Vă rugăm să ne contactați dacă aveți nevoie de ajutor. Ne puteți contacta la adresa keyboard@futo.org, folosind butonul de mai jos sau opțiunea Trimiteți feedback din secțiunea Ajutor</string>
  <string name="payment_screen_payment_failed_body_unconfident">Este posibil să fi apărut o problemă cu plata. Dacă a fost efectuată, ar trebui să primiți un e-mail cu o cheie de licență. Vă rugăm să ne contactați dacă aveți nevoie de ajutor. Ne puteți contacta la adresa keyboard@futo.org, folosind butonul de mai jos sau opțiunea Trimiteți feedback din ecranul principal.</string>
  <string name="payment_screen_license_integrity_error">Nu s-a putut verifica licența. Dacă considerați că este vorba de o eroare, vă rugăm să ne contactați.</string>
