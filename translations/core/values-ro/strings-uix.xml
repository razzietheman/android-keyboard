  <!-- Payment screen -->
  <string name="payment_screen_short_title">Plată</string>
  <string name="payment_screen_title">Plătește pentru tastatura FUTO</string>
  <string name="payment_screen_sales_paragraph_1"><![CDATA[<string name=\\\"payment_screen_sales_paragraph_1\\\">Utilizați tastatura FUTO de <xliff:g name=\\\"days\\\" example=\\\"30\\\">%d</xliff:g> zile. Dacă considerați că această aplicație este utilă, vă rugăm să luați în considerare achiziționarea ei pentru a sprijini dezvoltarea viitoare a software-ului FUTO.</string>]]></string>
  <string name="payment_screen_sales_paragraph_1_alt">Vă mulțumim că ați încercat tastatura FUTO! Dacă considerați că această aplicație este utilă, vă rugăm să luați în considerare achiziționarea ei pentru a sprijini dezvoltarea viitoare a software-ului FUTO.</string>
  <string name="payment_screen_sales_paragraph_2">FUTO se dedică creării de software de calitate, care nu abuzează de utilizatori. Această aplicație nu vă va afișa niciodată reclame și nu vă va colecta datele personale.</string>
  <string name="payment_screen_sales_point_development_title">Dezvoltare sustenabilă</string>
  <string name="payment_screen_sales_point_development_body">Misiunea FUTO este ca software-ul open-source și practicile comerciale non-răufăcătoare să devină o sursă de venit sustenabilă pentru proiecte și dezvoltatorii acestora. Din acest motiv, suntem în favoarea plății efective a software-ului de către utilizatori.</string>
  <string name="payment_screen_sales_point_privacy_title">Angajament față de confidențialitate</string>
  <string name="payment_screen_sales_point_privacy_body">Această aplicație nu vă va afișa niciodată reclame și nu vă va vinde datele. Nu ne ocupăm cu astfel de activități.</string>
  <string name="payment_screen_error_build_unsupported_payment">Plata nu este acceptată pe această versiune</string>
  <string name="payment_screen_already_paid_title">Deja ați plătit?</string>
  <string name="payment_screen_already_paid_body">Dacă ați plătit deja pentru FUTO Keyboard sau FUTO Voice Input, atingeți mai jos.</string>
  <string name="payment_screen_already_paid_button">Am plătit deja</string>
  <string name="payment_screen_already_paid_confirmation">Confirmați alegerea</string>
  <string name="payment_screen_already_paid_confirmation_body">Sunteți sigur că doriți să confirmați că ați plătit deja? Odată confirmat, nu vi se va mai solicita să plătiți din nou.</string>
  <string name="payment_screen_already_paid_confirmation_confirm">Am plătit deja</string>
  <string name="payment_screen_already_paid_confirmation_cancel">Anulează</string>
  <string name="payment_screen_set_reminder_title">Nu sunteți încă gata să plătiți?</string>
  <string name="payment_screen_set_reminder_body">Aceasta va ascunde notificarea de reamintire din ecranul de setări pentru numărul de zile introdus.</string>
  <string name="payment_screen_set_reminder_setter">Când doriți să vi se reamintească?</string>
  <string name="payment_screen_set_reminder_setter_7_days">în 7 zile</string>
  <string name="payment_screen_set_reminder_setter_1_month">într-o lună</string>
  <string name="payment_screen_set_reminder_setter_6_months">în 6 luni</string>
  <string name="payment_screen_set_reminder_setter_next_century">secolul următor</string>
  <string name="payment_screen_set_reminder_setter_confirm">Confirmare reamintire</string>
